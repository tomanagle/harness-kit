#!/bin/sh
# Development wrapper: rebuilds the harness-kit CLI from this checkout if
# needed (fast when nothing changed) and runs it with your arguments.
#
#   ./hk runtimes discover --output json
#   ./hk prompt -runtime fake "[approve] hello"
set -e
root=$(cd "$(dirname "$0")" && pwd)
(cd "$root" && go build -o bin/harness-kit ./cmd/harness-kit)
exec "$root/bin/harness-kit" "$@"
